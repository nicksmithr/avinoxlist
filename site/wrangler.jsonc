{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avinoxlist",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avinoxlist-bikes",
      "database_id": "5e38bc90-b5b3-4e3f-8a45-4015b847924f"
    }
  ],
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "avinoxlist.com", "custom_domain": true },
    { "pattern": "www.avinoxlist.com", "custom_domain": true }
  ]
}
