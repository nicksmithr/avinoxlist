---
import Base from '../../layouts/Base.astro';
import { getBikeBySlug } from '../../lib/db';
import { getComponentValues } from '../../lib/component-value';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const bike = await getBikeBySlug(env.DB, slug!);

if (!bike) {
  return Astro.redirect('/');
}

const primaryImage = bike.images.find(i => i.is_primary)?.url || bike.images[0]?.url;
const title = `${bike.brand} ${bike.model} ${bike.build} — Avinox List`;
const description = `Full specs for the ${bike.brand} ${bike.model} ${bike.build}: ${bike.motor || 'Avinox'} motor, ${bike.battery_wh || '?'}Wh battery, ${bike.frame || ''} frame. ${bike.weight_kg ? bike.weight_kg + 'kg.' : ''}`;

const priceMap: Record<string, { amount: number; source_url: string | null; verified_at: string | null }> = {};
for (const p of bike.prices) {
  priceMap[p.currency] = { amount: p.amount, source_url: p.source_url, verified_at: p.verified_at };
}

const currencySymbols: Record<string, string> = { gbp: '£', eur: '€', usd: '$', cad: 'C$', aud: 'A$' };
const currencyOrder = ['gbp', 'eur', 'usd', 'cad', 'aud'];
const sortedPrices = Object.entries(priceMap).sort((a, b) => currencyOrder.indexOf(a[0]) - currencyOrder.indexOf(b[0]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${bike.brand} ${bike.model} ${bike.build}`,
  brand: { '@type': 'Brand', name: bike.brand },
  category: 'Electric Mountain Bike',
  description,
  image: bike.images.map(i => i.url),
  offers: bike.prices.map(p => ({
    '@type': 'Offer',
    priceCurrency: p.currency.toUpperCase(),
    price: p.amount.toString(),
    url: `https://avinoxlist.com/bikes/${slug}`,
    availability: bike.status === 'NEW' ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock',
  })),
};

const cv = getComponentValues(bike, 'gbp');
const cvComponents = [
  { label: 'Fork', value: bike.fork, est: cv.fork },
  { label: 'Rear Shock', value: bike.shock, est: cv.shock },
  { label: 'Drivetrain', value: bike.drivetrain, est: cv.drivetrain },
  { label: 'Brakes', value: bike.brakes, est: cv.brakes },
  { label: 'Wheelset', value: bike.wheelset, est: cv.wheelset },
  { label: 'Dropper', value: bike.dropper, est: cv.dropper },
].filter(c => c.value);

const specs = [
  { label: 'Motor', value: bike.motor },
  { label: 'Peak Power', value: bike.peak_w ? `${bike.peak_w}W` : null },
  { label: 'Peak Torque', value: bike.peak_nm ? `${bike.peak_nm}Nm` : null },
  { label: 'Battery', value: bike.battery_wh ? `${bike.battery_wh}Wh` : null },
  { label: 'Battery Type', value: bike.battery_type },
  { label: 'Removable', value: bike.removable },
  { label: 'Travel F/R', value: bike.front_travel_mm && bike.rear_travel_mm ? `${bike.front_travel_mm}/${bike.rear_travel_mm}mm` : null },
  { label: 'Frame', value: bike.frame },
  { label: 'Wheels', value: bike.wheels },
  { label: 'Weight', value: bike.weight_kg ? `${bike.weight_kg}kg / ${(bike.weight_kg * 2.20462).toFixed(1)}lb` : null },
  { label: 'Fork', value: bike.fork },
  { label: 'Rear Shock', value: bike.shock },
  { label: 'Drivetrain', value: bike.drivetrain },
  { label: 'Brakes', value: bike.brakes },
  { label: 'Wheelset', value: bike.wheelset },
  { label: 'Dropper', value: bike.dropper },
  { label: 'Country', value: bike.country },
].filter(s => s.value);
---
<Base title={title} description={description} ogImage={primaryImage} canonical={`https://avinoxlist.com/bikes/${slug}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="max-w-5xl mx-auto px-6 py-8">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-3)] hover:text-[var(--color-text)] transition-colors group">
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
      </svg>
      Back to all bikes
    </a>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Image Gallery -->
      <div class="space-y-3">
        {primaryImage && (
          <div class="bg-[var(--color-surface)] rounded-2xl overflow-hidden aspect-[4/3] flex items-center justify-center p-6">
            <img src={primaryImage} alt={`${bike.brand} ${bike.model}`} class="bike-img max-w-full max-h-full object-contain" />
          </div>
        )}
        {bike.images.length > 1 && (
          <div class="grid grid-cols-4 gap-2">
            {bike.images.slice(0, 4).map(img => (
              <div class="bg-[var(--color-surface)] rounded-xl overflow-hidden aspect-square flex items-center justify-center p-2 hover:bg-[var(--color-border)] transition-colors cursor-pointer">
                <img src={img.url} alt={img.alt_text || `${bike.brand} ${bike.model}`} class="bike-img max-w-full max-h-full object-contain" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Info -->
      <div>
        <p class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-text-3)] font-medium">{bike.brand} · {bike.country}</p>
        <h1 class="text-4xl font-black mt-1 tracking-tight">{bike.model}</h1>
        <p class="text-lg text-[var(--color-text-2)] mt-0.5">{bike.build}</p>

        <!-- Prices -->
        <div class="mt-6 flex flex-wrap gap-3">
          {sortedPrices.map(([cur, { amount, source_url, verified_at }]) => (
            <div class="bg-[var(--color-surface)] rounded-xl px-4 py-3 min-w-[140px]">
              <div class="text-2xl font-bold tracking-tight">{currencySymbols[cur]}{amount.toLocaleString()}</div>
              <div class="text-[10px] text-[var(--color-text-3)] flex items-center gap-1.5 mt-1">
                <span class="font-medium">{cur.toUpperCase()}</span>
                {source_url && (
                  <a href={source_url} target="_blank" rel="noopener" class="text-[var(--color-accent)] hover:underline">source</a>
                )}
                {verified_at && <span class="opacity-60">{verified_at.slice(0, 10)}</span>}
              </div>
            </div>
          ))}
        </div>

        <!-- Key Stats -->
        <div class="mt-6 grid grid-cols-3 gap-3">
          {bike.motor && (
            <div class="text-center bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl py-4">
              <div class="text-lg font-bold">{bike.motor}</div>
              <div class="text-[10px] text-[var(--color-text-3)] uppercase tracking-wider mt-0.5">Motor</div>
            </div>
          )}
          {bike.battery_wh && (
            <div class="text-center bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl py-4">
              <div class="text-lg font-bold">{bike.battery_wh}<span class="text-sm font-medium text-[var(--color-text-2)]">Wh</span></div>
              <div class="text-[10px] text-[var(--color-text-3)] uppercase tracking-wider mt-0.5">Battery</div>
            </div>
          )}
          {bike.weight_kg && (
            <div class="text-center bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl py-4">
              <div class="text-lg font-bold">{bike.weight_kg}<span class="text-sm font-medium text-[var(--color-text-2)]">kg</span></div>
              <div class="text-[10px] text-[var(--color-text-3)] uppercase tracking-wider mt-0.5">Weight</div>
            </div>
          )}
        </div>

        <!-- Links -->
        <div class="mt-6 flex flex-wrap gap-2">
          {bike.source_url && (
            <a href={bike.source_url} target="_blank" rel="noopener"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-text)] text-white text-sm font-medium hover:opacity-90 transition-opacity">
              Manufacturer page
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          )}
          {bike.instagram && (
            <a href={bike.instagram} target="_blank" rel="noopener"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-[var(--color-border)] text-sm font-medium hover:border-[var(--color-text-3)] transition-colors">
              Instagram
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          )}
          <a href={`/compare/?bike1=${slug}`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-[var(--color-border)] text-sm font-medium hover:border-[var(--color-text-3)] transition-colors">
            Compare with...
          </a>
        </div>
      </div>
    </div>

    <!-- Full Spec Table -->
    <section class="mt-14">
      <h2 class="text-lg font-bold mb-4 flex items-center gap-3">
        Technical Specifications
        <div class="h-px flex-1 bg-[var(--color-border)]" />
      </h2>
      <div class="bg-[var(--color-bg-card)] rounded-2xl border border-[var(--color-border)] overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            {specs.map((s, i) => (
              <tr class={`${i % 2 === 0 ? 'bg-[var(--color-surface)]/40' : ''} ${i < specs.length - 1 ? 'border-b border-[var(--color-border)]/50' : ''}`}>
                <th class="text-left px-5 py-3.5 font-medium text-[var(--color-text-3)] w-1/3 text-xs uppercase tracking-wider">{s.label}</th>
                <td class="px-5 py-3.5 text-[var(--color-text)]">{s.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {bike.weight_source && (
        <p class="mt-3 text-xs text-[var(--color-text-3)] leading-relaxed">
          <span class="font-medium">Weight source:</span> {bike.weight_source}
        </p>
      )}
      {bike.notes && (
        <p class="mt-2 text-xs text-[var(--color-text-3)] leading-relaxed">
          <span class="font-medium">Notes:</span> {bike.notes}
        </p>
      )}
    </section>

    {cvComponents.length > 0 && (
      <section class="mt-10">
        <h2 class="text-lg font-bold mb-4 flex items-center gap-3">
          Component Value Estimate
          <div class="h-px flex-1 bg-[var(--color-border)]" />
        </h2>
        <div class="bg-[var(--color-bg-card)] rounded-2xl border border-[var(--color-border)] overflow-hidden">
          <table class="w-full text-sm">
            <tbody>
              {cvComponents.map((c, i) => (
                <tr class={`${i % 2 === 0 ? 'bg-[var(--color-surface)]/40' : ''} ${i < cvComponents.length - 1 ? 'border-b border-[var(--color-border)]/50' : ''}`}>
                  <th class="text-left px-5 py-3.5 font-medium text-[var(--color-text-3)] w-1/5 text-xs uppercase tracking-wider">{c.label}</th>
                  <td class="px-5 py-3.5 text-[var(--color-text)]">{c.value}</td>
                  <td class="px-5 py-3.5 text-right text-[var(--color-text-2)] tabular-nums">{c.est ? `£${c.est.toLocaleString()}` : '—'}</td>
                </tr>
              ))}
              <tr class="border-t-2 border-[var(--color-border)] font-bold">
                <th class="text-left px-5 py-4 text-xs uppercase tracking-wider">Total</th>
                <td></td>
                <td class="px-5 py-4 text-right tabular-nums">£{cv.total.toLocaleString()}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-[10px] text-[var(--color-text-3)]">
          Approximate aftermarket retail prices (GBP). The difference vs bike price reflects frame, motor, battery, and assembly.
        </p>
      </section>
    )}
  </div>
</Base>
